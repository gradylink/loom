import ./test2.loom

let myVar = 10; -- Semicolons are optional
const myVar2 = -(-8);

func getValue(): int {
  say ${myExportedVar}

  return 68;
}

func argsTest(swizzle1: int, swizzle2: int): int {
  return swizzle1 + swizzle2 + 5
}

func sendMessage() { -- Implicit void return type
  say ${myVar};
  title @a title "Hello: ${myVar} is the value";
}

enum TestEnum {
  Value1,
  Value2
}

#load func load() {
  let myListTest: string[] = ["swizzle magic", "swizzle magic but index 1"];
  myListTest = append(myListTest, "omg!!")

  const myEnumTestVar = TestEnum.Value2;
  say ${myEnumTestVar}

  let myStrVar1 = "hello";
  myStrVar1 = myStrVar1 + ", world!"
  myStrVar1 = myStrVar1[0..3] -- turn into "hell"

  if barrier at 1 1 -1 {}

  for i in 5..8 {
    say loops! ${i}
  }

  as @a at @s in minecraft:the_end {
    tp @s ~ ~ ~
  }

  say ${argsTest(7, 12)}

  myVar = myVar + 1;
  sendMessage();
  say ${myVar} is cool!;
 
  title @a subtitle "${myVar2}";

  const myValue = getValue() + 3;
  say ${myValue};

  let boolTest = true || false;
  say ${boolTest};

  if boolTest {
    say hi!
  } else {
    say loom is awesome
  }

  if myValue >= 100 {
    title @a actionbar swizzle magic
  }

  return;
  say it will never get here;
}
