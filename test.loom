let myVar: int = 10; -- Semicolons are optional
const myVar2: int = -(-8);

func getValue(): int {
  return 68;
}

func argsTest(swizzle1: int, swizzle2: int): int {
  return $swizzle1 + $swizzle2 + 5
}

func sendMessage() { -- Implicit void return type
  say $myVar;
  title @a title "Hello: $myVar is the value";
}

func load() {
  const argsResult: int = argsTest(7, 12);
  say $argsResult

  $myVar = $myVar + 1; -- Leading "$" here is optional
  sendMessage();
  say $myVar2 is cool!;
 
  title @a subtitle "$myVar2";

  const myValue: int = getValue() + 3;
  say $myValue;

  let boolTest: bool = true || false;
  say $boolTest;

  if $boolTest {
    say hi!
  } else {
    say loom is awesome
  }

  if $myValue >= 100 {
    title @a actionbar swizzle magic
  }

  return;
  say it will never get here;
}
