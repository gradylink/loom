import ./test2.loom

let myVar = 10; -- Semicolons are optional
const myVar2 = -(-8);

func getValue(): int {
  say ${myExportedVar}

  return 68;
}

func argsTest(swizzle1: int, swizzle2: int): int {
  return swizzle1 + swizzle2 + 5
}

func sendMessage() { -- Implicit void return type
  say ${myVar};
  title @a title "Hello: ${myVar} is the value";
}

enum TestEnum {
  Value1,
  Value2
}

struct SickStruct {
  item1: int,
  item2: string
}

struct SwizzleStruct {
  item1: SickStruct,
  item2: string[]
}

#load func load() {
  let testStruct = SwizzleStruct{ item1: SickStruct{ item1: 1, item2: "hello" }, item2: ["sick", "string", "list"] };

  let myListTest: string[] = ["swizzle magic", "swizzle magic but index 1"];
  myListTest = append(myListTest, "omg!!")

  const myEnumTestVar = TestEnum.Value2;
  say ${myEnumTestVar}

  const myCastTest1 = 15 as float;
  const myCastTest2 = myCastTest1 as int;
  say ${myCastTest1} ${myCastTest2}

  let myDynInt = 15;
  let myDynFloat = myDynInt as float;
  let myDynInt2 = myDynFloat as int;
  let myDynBool = myDynInt2 as bool;
  say ${myDynFloat} ${myDynInt2} ${myDynBool}

  let testShortCircuit = false && (myDynInt == 10);
  let testShortCircuit2 = true || (myDynInt == 15);
  say ${testShortCircuit} ${testShortCircuit2}

  const myConstStr = "Loom is great!";
  say ${myConstStr}

  let myStrVar1 = "hello";
  myStrVar1 = myStrVar1 + ", world!"
  myStrVar1 = myStrVar1[0..3] -- turn into "hell"

  if barrier at 1 1 -1 {}

  for i in 5..8 {
    say loops! ${i}
  }

  as @a at @s in minecraft:the_end {
    tp @s ~ ~ ~
  }

  say ${argsTest(7, 12)}

  myVar = myVar + 1;
  sendMessage();
  say ${myVar} is cool!;
 
  title @a subtitle "${myVar2}";

  const myValue = getValue() + 3;
  say ${myValue};

  let boolTest = true || false;
  say ${boolTest};

  if boolTest {
    say hi!
  } else {
    say loom is awesome
  }

  if myValue >= 100 {
    title @a actionbar swizzle magic
  }

  return;
  say it will never get here;
}
