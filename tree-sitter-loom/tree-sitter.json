{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "loom",
      "camelcase": "Loom",
      "title": "Loom",
      "scope": "source.loom",
      "file-types": [
        "loom"
      ],
      "injection-regex": "^loom$",
      "class-name": "TreeSitterLoom"
    }
  ],
  "metadata": {
    "version": "0.1.1",
    "license": "MIT",
    "description": "A programming language that compiles to Minecraft datapacks.",
    "authors": [
      {
        "name": "Grady Link",
        "email": "loom@grady.link"
      }
    ],
    "links": {
      "repository": "https://github.com/gradylink/loom"
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "node": true,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
