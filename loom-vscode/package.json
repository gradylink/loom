{
  "name": "loom-language",
  "displayName": "Loom",
  "description": "Language support for the Loom programming language (for Minecraft datapacks)",
  "repository": {
    "type": "git",
    "url": "https://github.com/gradylink/loom"
  },
  "version": "0.1.1",
  "publisher": "grady-link",
  "license": "BSD-3-Clause",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "loom",
    "minecraft",
    "datapack"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "loom",
        "aliases": [
          "Loom",
          "loom"
        ],
        "extensions": [
          ".loom"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "loom",
        "scopeName": "source.loom",
        "path": "./syntaxes/loom.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Loom",
      "properties": {
        "loom.executablePath": {
          "type": "string",
          "default": "loom",
          "description": "Path to the Loom compiler executable. Defaults to 'loom' (assumes it is on PATH)."
        },
        "loom.lspEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Loom Language Server for diagnostics, hover, completions, and go-to-definition."
        },
        "loom.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the Loom Language Server."
        }
      }
    },
    "semanticTokenTypes": [
      { "id": "namespace", "description": "A namespace or module alias" },
      { "id": "type", "description": "A struct or enum type" },
      { "id": "parameter", "description": "A function parameter" },
      { "id": "variable", "description": "A variable" },
      { "id": "property", "description": "A struct field" },
      { "id": "function", "description": "A function or command" },
      { "id": "method", "description": "A struct method" },
      { "id": "keyword", "description": "A keyword or boolean literal" },
      { "id": "comment", "description": "A comment" },
      { "id": "string", "description": "A string literal" },
      { "id": "number", "description": "A numeric literal" },
      { "id": "operator", "description": "An operator" },
      { "id": "decorator", "description": "An attribute or entity annotation" }
    ],
    "semanticTokenModifiers": [
      { "id": "readonly", "description": "A constant" },
      { "id": "defaultLibrary", "description": "A built-in provided by the language" }
    ],
    "commands": [
      {
        "command": "loom.restartServer",
        "title": "Loom: Restart Language Server"
      },
      {
        "command": "loom.showOutput",
        "title": "Loom: Show Language Server Output"
      }
    ],
    "snippets": [
      {
        "language": "loom",
        "path": "./snippets/loom.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "bun run compile",
    "compile": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --external:web-tree-sitter --format=cjs --platform=node && node scripts/copy-grammar-assets.mjs",
    "watch": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --external:web-tree-sitter --format=cjs --platform=node --watch",
    "package": "bun run compile && bunx vsce package --no-dependencies",
    "lint": "eslint src --ext ts"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "web-tree-sitter": "^0.26.10"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "@vscode/vsce": "^2.0.0",
    "esbuild": "^0.19.0"
  }
}
