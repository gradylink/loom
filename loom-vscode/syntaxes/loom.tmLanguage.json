{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Loom",
  "scopeName": "source.loom",
  "fileTypes": ["loom"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#number" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-dash.loom",
      "match": "--.*$"
    },

    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.loom",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "include": "#interpolation" },
            { "include": "#escape-sequence" }
          ]
        },
        {
          "name": "string.quoted.single.loom",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "include": "#interpolation" },
            { "include": "#escape-sequence" }
          ]
        }
      ]
    },

    "interpolation": {
      "name": "meta.interpolation.loom",
      "begin": "\\$\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.section.interpolation.begin.loom" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.interpolation.end.loom" }
      },
      "patterns": [{ "include": "#string" }, { "include": "#number" }]
    },

    "escape-sequence": {
      "name": "constant.character.escape.loom",
      "match": "\\\\[\"'\\\\bfnrtv]"
    },

    "number": {
      "name": "constant.numeric.loom",
      "match": "\\b\\d+(?:\\.\\d+)?\\b"
    }
  }
}
